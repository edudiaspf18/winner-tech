# Public site config — copy to `.env.local` for local overrides.
# Never commit real secrets; these IDs are public-by-design but keep envs out of git if preferred.

# Public origin used for canonical, sitemap, robots and Open Graph URLs.
# Defaults to https://winnertech.com.br when empty.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to skip loading gtag (site works without third-party analytics).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (digits only). Leave empty to skip loading the pixel.
# When set, WhatsApp CTA clicks also fire the standard `Contact` event.
NEXT_PUBLIC_META_PIXEL_ID=
